<?xml version="1.0" encoding="UTF-8"?>
<!--
  Window manager defaults (xfconf reads $XDG_CONFIG_DIRS, which includes /etc/xdg).
  The Amaara theme is generated by os/brand/make-xfwm-theme.py: cream titlebars,
  one hairline, three controls on the left.
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <!-- Locked for every user: the window chrome is the OS, not a preference.
         locked takes a user list and "*" means everyone (unlocked defaults to
         "*"); locking is only honoured in system files like this one. -->
    <property name="theme" type="string" value="Amaara" locked="*"/>
    <property name="title_font" type="string" value="Inter 10.5" locked="*"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="button_layout" type="string" value="CHM|" locked="*"/>
    <property name="double_click_action" type="string" value="maximize"/>
    <!-- Compositing gives the dock its translucency and the windows their
         shadows; without it the desktop looks flat and cheap. -->
    <property name="use_compositing" type="bool" value="true"/>
    <property name="frame_opacity" type="int" value="100"/>
    <property name="snap_to_window" type="bool" value="true"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="tile_on_move" type="bool" value="true"/>
    <property name="workspace_count" type="int" value="2"/>

    <!-- Shortcuts. Left out of the lock on purpose: the chrome is the OS, the
         keys are the user's. Names are xfwm4's own shortcut ids, verified against
         the binary's symbol table rather than guessed; the value is a GTK
         accelerator, so '&lt;Super&gt;Left' is the Super key plus arrow. -->
    <property name="keys" type="empty">
      <property name="tile_left_key" type="string" value="&lt;Super&gt;Left"/>
      <property name="tile_right_key" type="string" value="&lt;Super&gt;Right"/>
      <property name="tile_up_key" type="string" value="&lt;Super&gt;Up"/>
      <property name="tile_down_key" type="string" value="&lt;Super&gt;Down"/>
      <property name="close_window_key" type="string" value="&lt;Super&gt;w"/>
      <property name="fullscreen_key" type="string" value="&lt;Super&gt;f"/>
      <property name="show_desktop_key" type="string" value="&lt;Super&gt;d"/>
      <property name="next_workspace_key" type="string" value="&lt;Super&gt;Page_Down"/>
      <property name="prev_workspace_key" type="string" value="&lt;Super&gt;Page_Up"/>
    </property>
  </property>
</channel>

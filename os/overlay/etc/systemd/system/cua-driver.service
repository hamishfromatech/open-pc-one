[Unit]
Description=AmaaraOS cua-driver (semantic desktop control, unix socket)
After=openpc-session.service openpc-speech.service
Wants=openpc-session.service
Before=openpc-engine.service

[Service]
Type=simple
User=openpc
Group=openpc
Environment=DISPLAY=:0
# The root filesystem is read-only. cua-driver creates $HOME/.cua-driver when it
# is asked to turn telemetry off, and the pilot image logged
#   cua-driver: failed to disable telemetry: ... /home/openpc/.cua-driver:
#   Read-only file system (os error 30)
# so give the daemon its own writable home (created by tmpfiles.d/openpc.conf).
Environment=HOME=/var/lib/openpc/cua-driver
# Match the session's fixed bus socket (see os/scripts/openpc-session).
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/openpc/chrome/dbus/session-bus
# cua-driver does not ship bundled. It is pinned and baked to this path at image
# build time so resolution can never fail at runtime.
#
# 0.33.3 is a UNIX-SOCKET daemon, not a TCP listener. It has no --port; unknown
# flags are silently ignored, so the old `--port 8098 --display :0` argv was
# parsed as a positional JSON payload and died with
# `positional JSON arg to 'cua-driver 8098' did not parse`. The socket path is
# the only interface that exists.
ExecStart=/opt/openpc/bin/cua-driver serve --socket /run/openpc/cua-driver.sock
# The session bus is created by openpc-session; wait briefly for its socket so
# the AT-SPI listener is not disabled for the lifetime of the daemon.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 100); do [ -S /run/openpc/chrome/dbus/session-bus ] && exit 0; sleep 0.1; done; exit 0'
# Cua Driver ships content-free product telemetry ON by default. This appliance
# is sold as sovereign and air-gapped, so it must be off. Best-effort (-) so a
# future CLI change cannot block the driver from starting.
ExecStartPre=-/opt/openpc/bin/cua-driver telemetry disable
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# A leading dash makes a missing path non-fatal. Without it systemd fails the
# whole unit with 226/NAMESPACE before it ever execs the binary.
ReadWritePaths=/run/openpc /home/openpc/Desktop /var/lib/openpc/cua-driver
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressAllow=localhost

[Install]
WantedBy=openpc.target

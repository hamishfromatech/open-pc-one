[Unit]
Description=Mark the Open-PC One A/B slot as good after a successful boot
Documentation=https://github.com/hamishfromatech/open-pc-one
# systemd-boot boot counting: an update entry is installed as
# `openpc+b+3.conf`. Each failed boot decrements the counter; at 0 the entry is
# removed and the previous slot boots. Reaching this unit means userspace came
# up, so the slot is blessed and the counter is cleared.
DefaultDependencies=yes
After=openpc.target multi-user.target
Requires=openpc.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Two separate failures were hidden here before:
#   1. Debian trixie ships systemd-bless-boot in /usr/lib/systemd, not /usr/bin.
#   2. A leading '-' swallowed that miss, and RemainAfterExit=yes then reported
#      `active` while nothing ran, so A/B slot blessing silently never happened.
#
# The wrapper keeps the legitimate no-op — a non-boot-counted entry makes
# systemd-bless-boot exit non-zero, which is not an error — while making a
# MISSING binary a hard failure the boot probe can see.
ExecStart=/bin/sh -c 'test -x /usr/lib/systemd/systemd-bless-boot || { echo "systemd-bless-boot missing at /usr/lib/systemd/systemd-bless-boot" >&2; exit 1; }; /usr/lib/systemd/systemd-bless-boot good || echo "bless: entry is not boot-counted, nothing to clear"'
# The LED leaves BOOTING on this file.
ExecStartPost=/usr/bin/touch /run/openpc/boot-complete

[Install]
WantedBy=openpc.target

# AmaaraOS window decoration, generated by os/brand/make-xfwm-theme.py.
# Cream paper, one hairline, controls on the left like the desktop the rest of
# the world learned on. Do not hand-edit: change the generator.
# xfwm4 assigns *symbol names* here, not colours: the colour comes from the
# theme's XPM colour table, and a PNG-only theme has no table to read. Writing a
# hex value (or leaving these out) makes xfwm4 draw no title text at all, while
# the frame and buttons still render - which is how that bug hid.
active_text_color=active_text_color_2
inactive_text_color=inactive_text_color_2
active_text_shadow_color=active_hilight_2
inactive_text_shadow_color=inactive_hilight_2
title_shadow_active=false
title_shadow_inactive=false
title_font=Inter 10
title_vertical_offset_active=1
title_vertical_offset_inactive=1
button_offset=6
button_spacing=6
# All three controls on the left, in the order the desktop world reads them:
# C = close, H = hide (minimise), M = maximise; '|' splits left from right.
# (Upstream's options table prints H = shade, but the stock layout O|HMC has a
# minimise button and no shade button, so H is hide and S is stick.)
button_layout=CHM|
full_width_title=true
title_alignment=center
maximized_offset=0
shadow_delta_height=0
shadow_delta_width=0
shadow_delta_x=0
shadow_delta_y=-3
shadow_opacity=40

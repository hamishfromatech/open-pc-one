/* Same colour as the panel: with a compositor the rounded panel floats, and
   without one the window behind it is the same cream instead of black. */
window {{ background: {CREAM_SOLID}; }}
.spot .result .sub {{ color: {MUTED}; font-size: 11.5px; }}
.spot .hint {{ color: {MUTED}; font-size: 11px; padding: 10px 6px 0 6px; }}

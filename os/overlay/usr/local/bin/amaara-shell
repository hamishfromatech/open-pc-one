  padding: 8px 10px; color: {INK}; font-size: 13px; }}
.spot .action:hover {{ background: rgba(228,214,202,0.75); }}
.spot .action:hover {{ background: rgba(228,214,202,0.75); }}
.spot .action.danger {{ color: {RED_DEEP}; }}
/* same panel, square corners: no compositor, no rim */
.spot.flat {{ border-radius: 0; }}
/* Lock screen: one field, one rule, one clock. Anything busier looks like a
   screensaver instead of a lock. */
.lock {{ background: {CREAM_SOLID}; }}
.lock .kicker {{ color: {MUTED}; font-size: 11px; letter-spacing: 0.24em; }}
.lock .wordmark {{ font-family: "DejaVu Serif", serif; font-weight: 700;
  font-size: 74px; color: {INK}; }}
.lock .tag {{ color: {RED}; font-family: "DejaVu Serif", serif; font-style: italic;
  font-size: 26px; }}

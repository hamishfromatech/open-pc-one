def css() -> Gtk.CssProvider:
    provider = Gtk.CssProvider()
    provider.load_from_data(BAR_CSS.encode())
    return provider


def launch(argv: list[str]) -> None:
    binary = shutil.which(argv[0])
    if binary is None:
        return
    try:
        subprocess.Popen([binary, *argv[1:]], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:  # pragma: no cover - environment dependent
        print(f"amaara-shell: cannot launch {argv[0]}: {exc}", file=sys.stderr)


class Shell:
    def __init__(self) -> None:
        provider = css()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.store = NotificationStore()
        self.centre = Centre(self.store)
        self.osd = Osd()
        self.lock_screen = LockScreen(on_lock=self._cover_surfaces,
                                      on_unlock=self._reveal_surfaces)
        self.launcher = Launcher(self.lock_screen)
        self.bar = self._bar()
        self.dock = self._dock()
        self._last_volume = _volume()
        self.notify_service = start_notification_service(self.store, self._on_notification)

    # -- windows -----------------------------------------------------------

    @staticmethod
    def _surface() -> Gtk.Window:
        window = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        window.set_decorated(False)
        window.set_resizable(False)
        window.set_skip_taskbar_hint(True)
        window.set_skip_pager_hint(True)
        window.set_keep_above(True)
        window.set_accept_focus(False)
        window.set_type_hint(Gdk.WindowTypeHint.DOCK)
        window.set_app_paintable(True)
        screen = window.get_screen()
        visual = screen.get_rgba_visual()
        if visual is not None and screen.is_composited():
            window.set_visual(visual)
        return window

    def _bar(self) -> Gtk.Window:
        window = self._surface()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.get_style_context().add_class("bar")

        self.rule = Gtk.Box()
        self.rule.get_style_context().add_class("rule")
        self.rule.set_valign(Gtk.Align.CENTER)
        # The wordmark is the menu button, the way a desktop's own mark is: one
        # click, one place to search everything.
        word = Gtk.Button()
        word.set_relief(Gtk.ReliefStyle.NONE)
        word.set_focus_on_click(False)
        label = Gtk.Label(label="AmaaraOS")
        label.get_style_context().add_class("wordmark")
        word.add(label)
        word.set_tooltip_text("Search apps and system")
        word.connect("clicked", lambda _b: self.launcher.toggle(self))
        self.word_button = word

        self.app_label = Gtk.Label(label="")
        self.app_label.get_style_context().add_class("app")
        self.app_label.set_ellipsize(3)  # Pango ellipsize middle

        left = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        left.pack_start(self.rule, False, False, 0)
        left.pack_start(word, False, False, 0)
        left.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 6)
        left.pack_start(self.app_label, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        self.net = Gtk.Label(label="")
        self.vol = Gtk.Label(label="")
        self.batt = Gtk.Label(label="")
        for widget in (self.net, self.vol, self.batt):
            widget.get_style_context().add_class("status")
            right.pack_start(widget, False, False, 0)
        dot = Gtk.Box()
        dot.get_style_context().add_class("dot")
        dot.set_valign(Gtk.Align.CENTER)
        right.pack_start(dot, False, False, 4)
        self.clock = Gtk.Label(label="")
        self.clock.get_style_context().add_class("clock")
        self.clock_button = Gtk.Button()
        self.clock_button.set_relief(Gtk.ReliefStyle.NONE)
        self.clock_button.set_focus_on_click(False)
        self.clock_button.add(self.clock)
        self.clock_button.set_tooltip_text("Notifications")
        self.clock_button.connect("clicked", lambda _b: self.centre.toggle())
        right.pack_end(self.clock_button, False, False, 0)
        self.unread = Gtk.Label(label="")
        self.unread.get_style_context().add_class("unread")
        self.unread.set_no_show_all(True)
        right.pack_end(self.unread, False, False, 6)

        box.pack_start(left, False, False, 0)
        box.pack_end(right, False, False, 0)
        window.add(box)

        width = screen_width()
        window.set_default_size(width, 30)
        window.resize(width, 30)
        window.move(0, 0)
        window.show_all()
        return window

    def _dock(self) -> Gtk.Window:
        window = self._surface()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.get_style_context().add_class("dock")

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        for _id, icon_file, icon_names, label, argv in APPS:
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            image = icon_widget(icon_file, icon_names)
            inner.pack_start(image, False, False, 0)
            caption = Gtk.Label(label=label)
            caption.get_style_context().add_class("label")
            inner.pack_start(caption, False, False, 0)
            button.add(inner)
            button.set_tooltip_text(label)
            button.connect("clicked", lambda _b, a=argv: launch(a))
            row.pack_start(button, False, False, 0)

        outer.pack_start(row, False, False, 0)
        window.add(outer)
        window.show_all()

        # Centre it after GTK knows how wide it is.
        GLib.idle_add(self._place_dock)
        return window

    def _place_dock(self) -> bool:
        width, height = self.dock.get_size()
        self.dock.move(max(0, (screen_width() - width) // 2), screen_height() - height - 10)
        return False

    # -- lock cover --------------------------------------------------------

    def _on_notification(self, note: Notification) -> None:
        self.osd.flash("", note.title or note.body or "Notification")
        self._paint_unread()

    def _paint_unread(self) -> None:
        count = self.store.unread
        if count:
            self.unread.set_text(str(min(count, 99)))
            self.unread.show()
        else:
            self.unread.hide()

    def _cover_surfaces(self) -> None:
        self.centre.hide()
        for surface in (self.bar, self.dock):
            surface.hide()

    def _reveal_surfaces(self) -> None:
        for surface in (self.bar, self.dock):
            surface.show_all()

    # -- live state --------------------------------------------------------

    def tick(self) -> bool:
        now = time.localtime()
        self.clock.set_text(time.strftime("%a %d %b  %H:%M", now))
        # Keep the bar's own clock in step with a lock screen that was showing
        # while the shell was busy.
        self.net.set_text("Ethernet" if os.path.exists("/sys/class/net/eth0") else "")
        level = _battery_percent()
        self.batt.set_text(f"{level}%" if level is not None else "")
        self.vol.set_text(_volume())
        self.app_label.set_text(_focused_window())
        # Volume has no hotkey daemon on this box, so the level is watched instead
        # of being triggered: any change, from any app, raises the OSD.
        level = _volume()
        if level != self._last_volume:
            self._last_volume = level
            if level:
                self.osd.flash("", f"Volume {level}")
        self._place_dock()
        return True


#: Where desktop entries live. Order matters: /usr/local wins over the
#: distribution's, and a user's own wins over both, like every other desktop.
ENTRY_DIRS = (
    "/usr/local/share/applications",
    "/usr/share/applications",
    os.path.expanduser("~/.local/share/applications"),
)

#: Launching an app with a field code left in its Exec line is a silent no-op, so
#: those tokens are dropped rather than passed through.
FIELD_CODES = ("%f", "%F", "%u", "%U", "%d", "%D", "%n", "%N", "%i", "%c", "%k", "%v", "%m")


def _desktop_field(text: str, key: str) -> str:
    """Read ``key=value`` out of the [Desktop Entry] section."""
    section = ""
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line.strip("[]")
            continue
        if section == "Desktop Entry" and line.startswith(key + "="):
            return line.split("=", 1)[1].strip()
    return ""


def desktop_entries() -> list[tuple[str, str, list[str]]]:
    """(name, comment, argv) for every launchable application on the box."""
    seen: set[str] = set()
    found: list[tuple[str, str, list[str]]] = []
    for directory in ENTRY_DIRS:
        if not os.path.isdir(directory):
            continue
        for filename in sorted(os.listdir(directory)):
            if not filename.endswith(".desktop") or filename in seen:
                continue
            seen.add(filename)
            try:
                text = Path(os.path.join(directory, filename)).read_text(encoding="utf-8")
            except OSError:
                continue
            if _desktop_field(text, "NoDisplay").lower() == "true":
                continue
            if _desktop_field(text, "Hidden").lower() == "true":
                continue
            label = _desktop_field(text, "Name")
            command = _desktop_field(text, "Exec")
            if not label or not command:
                continue
            argv = [token for token in shlex.split(command) if token not in FIELD_CODES]
            if not argv or shutil.which(argv[0]) is None:
                continue  # an entry for software that is not installed
            found.append((label, _desktop_field(text, "Comment"), argv))
    return found



class LockScreen(Gtk.Window):
    """The desktop covered: brand, clock, and one way back in.

    There is no password on this appliance by design (the agent runs as this
    user and the only remote access is the WSS edge), so this is a privacy cover
    rather than an authentication prompt. It says so instead of pretending.
    """

    def __init__(self, device: str = "", on_lock=None, on_unlock=None) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.on_lock = on_lock
        self.on_unlock = on_unlock
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.get_style_context().add_class("lock")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_border_width(84)
        box.set_margin_bottom(24)

        kicker = Gtk.Label(label="THE A-TECH CORPORATION")
        kicker.set_xalign(0)
        kicker.get_style_context().add_class("kicker")
        box.pack_start(kicker, False, False, 0)

        self.clock = Gtk.Label(label="")
        self.clock.set_xalign(0)
        self.clock.get_style_context().add_class("clock")
        box.pack_start(self.clock, False, False, 14)

        self.date = Gtk.Label(label="")
        self.date.set_xalign(0)
        self.date.get_style_context().add_class("date")
        box.pack_start(self.date, False, False, 0)

        rule = Gtk.Box()
        rule.get_style_context().add_class("rule")
        rule.set_size_request(46, 6)
        rule.set_margin_top(34)
        box.pack_start(rule, False, False, 0)

        word = Gtk.Label(label="AmaaraOS")
        word.set_xalign(0)
        word.get_style_context().add_class("wordmark")
        word.set_margin_top(22)
        box.pack_start(word, False, False, 0)

        tag = Gtk.Label(label="the operating system for your own AI")
        tag.set_xalign(0)
        tag.get_style_context().add_class("tag")
        box.pack_start(tag, False, False, 0)

        box.pack_start(Gtk.Box(), True, True, 0)

        hint = Gtk.Label(label="PRESS ENTER OR CLICK TO UNLOCK")
        hint.set_xalign(0)
        hint.get_style_context().add_class("hint")
        box.pack_start(hint, False, False, 0)

        self.device_label = Gtk.Label(label=device)
        self.device_label.set_xalign(0)
        self.device_label.get_style_context().add_class("device")
        self.device_label.set_margin_top(6)
        box.pack_start(self.device_label, False, False, 0)

        self.add(box)
        self.connect("key-press-event", self._on_key)
        # No focus-out close: the panel is presented over a kiosk browser that
        # takes focus back immediately, so it closed the instant it opened. The
        # clock toggles it, Esc closes it, and that is enough.
        self.connect("button-press-event", self._on_key)
        self.tick()

    def _on_key(self, *_args) -> bool:
        self.unlock()
        return True

    def tick(self) -> bool:
        now = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", now))
        self.date.set_text(time.strftime("%A %d %B", now))
        return True

    def lock(self) -> None:
        if self.on_lock is not None:
            self.on_lock()
        self.show_all()
        # The bar and the dock are keep-above too, so "on top" is decided by X
        # stacking order: raise again once the window is mapped, or the cover
        # comes up *behind* the shell it is supposed to hide.
        self.present()
        GLib.timeout_add(120, self._raise)
        GLib.timeout_add_seconds(10, self.tick)

    def _raise(self) -> bool:
        # fullscreen() before mapping is advisory; ask again once the window
        # exists, and keep asking while the cover is up.
        self.fullscreen()
        window = self.get_window()
        if window is not None:
            window.raise_()
        return self.get_visible()

    def unlock(self) -> None:
        self.hide()
        if self.on_unlock is not None:
            self.on_unlock()


def system_power(action: str) -> None:
    """Restart or power off, if this session is allowed to.

    On the appliance these need a polkit rule for the openpc user; until that
    exists the call fails and says so in the journal rather than lying to the UI.
    """
    if shutil.which("systemctl") is None:
        print(f"amaara-shell: systemctl is not present; cannot {action}", file=sys.stderr)
        return
    try:
        subprocess.Popen(["systemctl", action], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError as exc:  # pragma: no cover - environment dependent
        print(f"amaara-shell: cannot {action}: {exc}", file=sys.stderr)


class Launcher(Gtk.Window):
    """A search overlay: type, arrow, Enter.

    The dock is the four things that matter on this box; this is everything else
    that is installed, which is what a person expects from a desktop's own mark.
    """

    def __init__(self, lock_screen: LockScreen) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.lock_screen = lock_screen
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_resizable(False)
        self.set_app_paintable(True)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        composited = visual is not None and screen.is_composited()
        if composited:
            self.set_visual(visual)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        # ALWAYS "spot": every rule below is written as a descendant of it, so
        # swapping the class instead of adding one silently unstyles the panel
        # (that is how the selection colour went missing). "flat" only drops the
        # radius, for a session with no compositor to hide the rim behind.
        outer.get_style_context().add_class("spot")
        if not composited:
            outer.get_style_context().add_class("flat")

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Search apps and system…")
        outer.pack_start(self.entry, False, False, 0)

        self.head = Gtk.Label(label="Applications")
        self.head.set_xalign(0)
        self.head.get_style_context().add_class("head")
        outer.pack_start(self.head, False, False, 0)

        self.list = Gtk.ListBox()
        # No selection mode: the row highlight is ours, so the theme's accent
        # cannot come back, and there is no half-selected state to explain.
        self.list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list.set_activate_on_single_click(True)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        # A multiple of the row height, so the list never ends mid-row.
        scroller.set_max_content_height(41 * 9)
        scroller.set_propagate_natural_height(True)
        scroller.add(self.list)
        outer.pack_start(scroller, True, True, 0)

        # System actions live outside the scroller: a long app list must never
        # push "Power off" below the fold.
        self.footer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.footer.set_margin_top(8)
        for label, action in (("Lock screen", "lock"), ("Restart", "reboot"),
                              ("Power off", "poweroff")):
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("action")
            if action != "lock":
                button.get_style_context().add_class("danger")
            text = Gtk.Label(label=label)
            text.set_xalign(0)
            button.add(text)
            button.connect("clicked", lambda _b, a=action: self._system(a))
            self.footer.pack_start(button, False, False, 0)
        outer.pack_start(self.footer, False, False, 0)

        hint = Gtk.Label(label="Up/Down choose      Enter open      Esc close")
        hint.set_xalign(0)
        hint.get_style_context().add_class("hint")
        outer.pack_start(hint, False, False, 0)

        self.add(outer)
        self.entries = desktop_entries()
        self.results: list[tuple[str, list[str]]] = []


        self.entry.connect("changed", self._filter)
        self.entry.connect("activate", self._open_selected)
        # Clicking anywhere else closes it: an overlay that stays open behind the
        # app you just launched is the classic launcher bug.
        self.connect("focus-out-event", self._on_focus_out)
        self.connect("key-press-event", self._on_key)
        # No focus-out close: the panel is presented over a kiosk browser that
        # takes focus back immediately, so it closed the instant it opened. The
        # clock toggles it, Esc closes it, and that is enough.
        # Clicking anywhere else closes it: an overlay that stays open behind the
        # app you just launched is the classic launcher bug.
        self.connect("focus-out-event", self._on_focus_out)
        self.list.connect("row-activated", self._on_row)
        self.entry.connect("key-press-event", self._on_entry_key)
        self.current = 0
        self._filter()

    # -- behaviour ---------------------------------------------------------

    def _filter(self, *_args) -> None:
        needle = self.entry.get_text().strip().lower()
        self.results = []
        for child in self.list.get_children():
            self.list.remove(child)
        for name, comment, argv in self.entries:
            haystack = f"{name} {comment or ''}".lower()
            if needle and needle not in haystack:
                continue
            row = Gtk.ListBoxRow()
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            title = Gtk.Label(label=name)
            title.set_xalign(0)
            box.pack_start(title, False, False, 0)
            if comment:
                sub = Gtk.Label(label=comment[:70])
                sub.set_xalign(0)
                sub.get_style_context().add_class("sub")
                box.pack_start(sub, True, True, 0)
            row.add(box)
            row.get_style_context().add_class("result")
            self.list.add(row)
            self.results.append((name, argv))
            if len(self.results) >= 60:
                break
        self.head.set_text(f"Applications · {len(self.results)}" if needle else "Applications")
        self.current = 0
        self._paint_selection()

    def _paint_selection(self) -> None:
        rows = self.list.get_children()
        for index, child in enumerate(rows):
            if index == self.current:
                child.get_style_context().add_class("on")
            else:
                child.get_style_context().remove_class("on")

    def _move(self, delta: int) -> None:
        rows = len(self.list.get_children())
        if not rows:
            return
        self.current = max(0, min(rows - 1, self.current + delta))
        self._paint_selection()
        self.list.get_children()[self.current].grab_focus()

    def _on_entry_key(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_Down:
            self._move(1)
            return True
        if event.keyval == Gdk.KEY_Up:
            self._move(-1)
            return True
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._open_index(self.current)
            return True
        if event.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _open_index(self, index: int) -> None:
        if 0 <= index < len(self.results):
            argv = self.results[index][1]
            self.hide()
            if argv[0].startswith("amaara:"):
                self._system(argv[0].split(":", 1)[1])
            else:
                launch(argv)

    def _on_focus_out(self, *_args) -> bool:
        self.hide()
        return False

    def _on_key(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _on_row(self, _list, row) -> None:
        self._open_index(row.get_index())

    def _system(self, action: str) -> None:
        self.hide()
        if action == "lock":
            self.lock_screen.lock()
        else:
            system_power(action)

    def _open_selected(self, *_args) -> None:
        row = self.list.get_selected_row()
        if row is not None:
            self._on_row(self.list, row)

    def toggle(self, _relative_to: Gtk.Window | None = None) -> None:
        if self.get_visible():
            self.hide()
            return
        self.entries = desktop_entries()
        self.entry.set_text("")
        self._filter()
        self.show_all()
        width = 620
        self.resize(width, min(560, screen_height() - 160))
        self.move((screen_width() - width) // 2, max(60, screen_height() // 6))
        self.present()
        self.entry.grab_focus()


class Notification:
    """One thing the machine wants to tell the person in front of it."""

    __slots__ = ("app", "title", "body", "urgency", "notified_at")

    def __init__(self, app: str, title: str, body: str, urgency: int = 1) -> None:
        self.app = app
        self.title = title
        self.body = body
        self.urgency = urgency
        self.notified_at = time.time()

    def ago(self) -> str:
        delta = int(time.time() - self.notified_at)
        if delta < 60:
            return "now"
        if delta < 3600:
            return f"{delta // 60} min"
        if delta < 86400:
            return f"{delta // 3600} h"
        return f"{delta // 86400} d"


class NotificationStore:
    """Newest first, bounded, and never the source of truth for anything.

    A notification is a nudge, not a record: when the buffer is full the oldest
    one goes, because a centre you have to clear to stay usable is a bug.
    """

    def __init__(self, limit: int = 50) -> None:
        self.items: list[Notification] = []
        self.limit = limit
        self.unread = 0

    def add(self, app: str, title: str, body: str, urgency: int = 1) -> Notification:
        note = Notification(app, title, body, urgency)
        self.items.insert(0, note)
        del self.items[self.limit:]
        self.unread += 1
        return note

    def clear(self) -> None:
        self.items.clear()
        self.unread = 0

    def mark_read(self) -> None:
        self.unread = 0


class Centre(Gtk.Window):
    """The panel behind the clock: what happened, newest first."""

    def __init__(self, store: NotificationStore) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.store = store
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_resizable(False)
        self.get_style_context().add_class("centre")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.get_style_context().add_class("centre-body")

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="Notifications")
        title.set_xalign(0)
        title.get_style_context().add_class("centre-title")
        head.pack_start(title, True, True, 0)
        clear = Gtk.Button(label="Clear all")
        clear.set_relief(Gtk.ReliefStyle.NONE)
        clear.get_style_context().add_class("action")
        clear.connect("clicked", self._clear)
        head.pack_end(clear, False, False, 0)
        outer.pack_start(head, False, False, 0)

        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_max_content_height(520)
        scroller.set_propagate_natural_height(True)
        scroller.add(self.list)
        outer.pack_start(scroller, True, True, 0)

        self.add(outer)
        self.connect("key-press-event", self._on_key)
        # No focus-out close: the panel is presented over a kiosk browser that
        # takes focus back immediately, so it closed the instant it opened. The
        # clock toggles it, Esc closes it, and that is enough.
        self.refresh()

    def _on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def _clear(self, *_args) -> None:
        self.store.clear()
        self.refresh()

    def refresh(self) -> None:
        for child in self.list.get_children():
            self.list.remove(child)
        if not self.store.items:
            empty = Gtk.Label(label="Nothing yet.")
            empty.set_xalign(0)
            empty.get_style_context().add_class("empty")
            self.list.pack_start(empty, False, False, 0)
        for note in self.store.items[:20]:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            card.get_style_context().add_class("notif")
            if note.urgency >= 2:
                card.get_style_context().add_class("urgent")
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            app = Gtk.Label(label=note.app.upper())
            app.set_xalign(0)
            app.get_style_context().add_class("notif-app")
            when = Gtk.Label(label=note.ago())
            when.set_xalign(1)
            when.get_style_context().add_class("notif-when")
            line.pack_start(app, False, False, 0)
            line.pack_end(when, False, False, 0)
            card.pack_start(line, False, False, 0)
            if note.title:
                title = Gtk.Label(label=note.title)
                title.set_xalign(0)
                title.set_line_wrap(True)
                title.get_style_context().add_class("notif-title")
                card.pack_start(title, False, False, 0)
            if note.body:
                body = Gtk.Label(label=note.body)
                body.set_xalign(0)
                body.set_line_wrap(True)
                body.set_max_width_chars(38)
                body.get_style_context().add_class("notif-body")
                card.pack_start(body, False, False, 0)
            self.list.pack_start(card, False, False, 0)
        self.list.show_all()

    def toggle(self) -> None:
        if self.get_visible():
            self.hide()
            return
        self.refresh()
        self.show_all()
        width = 380
        # set_size_request, not resize(): this window is deliberately not
        # resizable, and GTK ignores resize() on those, which is why the panel kept
        # its natural width and clipped its own last card.
        cards = max(1, min(len(self.store.items), 4))
        height = min(screen_height() - 110, 120 + cards * 92)
        self.set_size_request(width, height)
        self.resize(width, height)
        self.move(screen_width() - width - 14, 40)
        self.present()
        self.store.mark_read()


class Osd(Gtk.Window):
    """The little pill that appears when a level changes.

    One line, one bar, gone in a second and a half. It is feedback, not a dialog:
    anything that waits for you to dismiss it is in the wrong layer.
    """

    def __init__(self) -> None:
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.get_style_context().add_class("osd")

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.get_style_context().add_class("osd-body")
        self.icon = Gtk.Label(label="")
        self.icon.get_style_context().add_class("osd-icon")
        self.label = Gtk.Label(label="")
        self.label.get_style_context().add_class("osd-label")
        box.pack_start(self.icon, False, False, 0)
        box.pack_start(self.label, False, False, 0)
        self.add(box)
        self._timer: int | None = None

    def flash(self, icon: str, text: str, seconds: float = 1.6) -> None:
        self.icon.set_text(icon)
        self.label.set_text(text)
        self.show_all()
        width, height = max(240, self.get_size()[0]), 64
        self.set_size_request(width, height)
        self.resize(width, height)
        self.move((screen_width() - width) // 2, screen_height() - 150)
        if self._timer is not None:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(int(seconds * 1000), self._hide)

    def _hide(self) -> bool:
        self._timer = None
        self.hide()
        return False


def start_notification_service(store: NotificationStore, on_add) -> object | None:
    """Serve org.freedesktop.Notifications, so app notifications reach the centre.

    Returns the service object (keep a reference: dbus drops the name when the
    object is collected) or None when python3-dbus is absent, in which case the
    centre still works for anything we raise ourselves. Silence is correct here -
    a missing optional bus module must not take the desktop with it.
    """
    try:
        import dbus
        import dbus.service
        from dbus.mainloop.glib import DBusGMainLoop
    except ImportError:
        print("amaara-shell: python3-dbus not installed; notifications are internal only",
              file=sys.stderr)
        return None

    try:
        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
    except Exception as exc:  # pragma: no cover - no session bus in this session
        print(f"amaara-shell: no session bus for notifications: {exc}", file=sys.stderr)
        return None

    class Notifications(dbus.service.Object):
        @dbus.service.method("org.freedesktop.Notifications", in_signature="susssasa{sv}i",
                             out_signature="u")
        def Notify(self, app_name, replaces_id, app_icon, summary, body, actions, hints, expire):
            note = store.add(str(app_name or "app"), str(summary or ""), str(body or ""),
                             int(hints.get("urgency", 1)) if hints else 1)
            on_add(note)
            return dbus.UInt32(1)

        @dbus.service.method("org.freedesktop.Notifications", in_signature="u",
                             out_signature="")
        def CloseNotification(self, notification_id):
            return None

        @dbus.service.method("org.freedesktop.Notifications", in_signature="",
                             out_signature="as")
        def GetCapabilities(self):
            return dbus.Array(["body", "urgency"], signature="s")

        @dbus.service.method("org.freedesktop.Notifications", in_signature="",
                             out_signature="ssss")
        def GetServerInformation(self):
            return ("AmaaraOS", "The A-Tech Corporation", "1.0.0", "1.2")

        @dbus.service.signal("org.freedesktop.Notifications", signature="uu")
        def NotificationClosed(self, notification_id, reason):
            return None

    try:
        service = Notifications(bus, "/org/freedesktop/Notifications")
        bus_name = dbus.service.BusName("org.freedesktop.Notifications", bus)
        service.bus_name = bus_name
    except Exception as exc:  # pragma: no cover - another server owns the name
        print(f"amaara-shell: notifications already served elsewhere: {exc}", file=sys.stderr)
        return None
    print("amaara-shell: serving org.freedesktop.Notifications", file=sys.stderr)
    return service


def screen_width() -> int:
    return Gdk.Display.get_default().get_primary_monitor().get_geometry().width


def screen_height() -> int:
    return Gdk.Display.get_default().get_primary_monitor().get_geometry().height


def _read(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def _battery_percent() -> int | None:
    for entry in ("BAT0", "BAT1"):
        value = _read(f"/sys/class/power_supply/{entry}/capacity")
        if value.isdigit():
            return int(value)
    return None


def _volume() -> str:
    """PulseAudio/PipeWire volume, if there is any. Silence is not a crash."""
    if shutil.which("pactl") is None:
        return ""
    try:
        out = subprocess.run(["pactl", "get-sink-volume", "@DEFAULT_SINK@"],
                             capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    for token in out.replace("%", " ").split():
        if token.isdigit():
            return f"{token}%"
    return ""


def _focused_window() -> str:
    """Name of the focused app, for the bar. Best effort: no X tool, no name."""
    if shutil.which("xdotool") is None:
        return ""
    try:
        window = subprocess.run(["xdotool", "getactivewindow"], capture_output=True,
                                text=True, timeout=2).stdout.strip()
        if not window:
            return ""
        name = subprocess.run(["xdotool", "getwindowname", window], capture_output=True,
                              text=True, timeout=2).stdout.strip()
        # Our own surfaces are not "an app": the bar must not answer itself.
        if name.startswith("amaara-shell"):
            return ""
        return name[:60]
    except (OSError, subprocess.SubprocessError):
        return ""


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if "--lock" in argv:
        # Lock on its own, without a shell: what the autostart hook uses so the
        # cover is up before the desktop is, and what a test can drive.
        Gtk.init([])
        provider = css()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        screen = LockScreen()
        screen.lock()
        Gtk.main()
        return 0

    shell = Shell()
    GLib.timeout_add_seconds(5, shell.tick)
    shell.tick()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

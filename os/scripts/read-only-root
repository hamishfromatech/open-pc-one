#!/bin/bash
# Prepare the appliance root for a read-only life.
#
# Writable state lives on the separate openpc-var partition, which
# systemd-gpt-auto-generator mounts at /var from the partition type - no fstab
# entry needed. This script only prepares the directories; enforcing `ro` on /
# is a boot-time concern and is not switched on until the A/B entries carry a
# matching `ro` option for both slots.
set -euo pipefail

ROOT="${1:?usage: read-only-root <buildroot>}"
[ -d "$ROOT" ] || { echo "read-only-root: no such buildroot: $ROOT" >&2; exit 1; }

# The writable directories the units name. Creating them here (and again in
# tmpfiles) means the image boots even if tmpfiles is late.
for path in var/lib/openpc var/lib/openpc/sessions var/lib/openpc/tls \
            var/lib/openpc/models var/lib/openpc/llama-cache; do
  install -d -m 0755 "$ROOT/$path"
done

echo "read-only-root prepared: writable state under /var/lib/openpc"

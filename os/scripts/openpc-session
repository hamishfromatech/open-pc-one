#!/bin/bash
# Start the headless desktop: Xvfb + XFCE + Chrome.
#
# There is no monitor. Xvfb is the only display, and Chrome is what the agent
# actually drives. systemd supervises this script; the trap makes sure a
# failure of any child tears the whole unit down (so the LED says "needs
# attention" instead of pretending the desktop is up).
set -euo pipefail

DISPLAY_NUM="${DISPLAY_NUM:-:0}"
SCREEN="${OPENPC_SCREEN:-1920x1080x24}"
export DISPLAY="$DISPLAY_NUM"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/openpc/chrome}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/run/openpc/chrome/cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/run/openpc/chrome/config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-/run/openpc/chrome/data}"
CHROME_USER_DIR="$XDG_CONFIG_HOME/chrome"
FLAG_DIR="${OPENPC_RUN_DIR:-/run/openpc}"

log() { printf '%s openpc-session: %s\n' "$(date -Is)" "$*" >&2; }

cleanup() {
  log "shutting down"
  kill 0 2>/dev/null || true
}
trap cleanup EXIT TERM INT

mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" \
  "$CHROME_USER_DIR" "$XDG_RUNTIME_DIR/dbus"

# Xvfb and the ICE protocol refuse to create these directories when euid is not
# 0, and PrivateTmp=yes means the image's /usr/lib/tmpfiles.d/x11.conf entry is
# not visible here. The service owns its private /tmp, so create them first.
mkdir -p /tmp/.X11-unix /tmp/.ICE-unix
chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix

# XFCE and Chrome need a session bus. Relying on dbus-launch is not enough: it
# writes $HOME/.dbus, the root filesystem is read-only, and Chrome then fails
# every bus call with "Could not parse server address". A fixed socket path also
# lets cua-driver join the same bus from its own unit.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/dbus/session-bus"
# XFCE tries to write ~/.ICEauthority, which is read-only.
export ICEAUTHORITY="$XDG_RUNTIME_DIR/ICEauthority"
rm -f "$XDG_RUNTIME_DIR/dbus/session-bus"
dbus-daemon --session --fork --address="$DBUS_SESSION_BUS_ADDRESS"

# Xvfb must be listening before XFCE starts, otherwise the session dies with
# "cannot open display" on a slow boot.
Xvfb "$DISPLAY_NUM" -screen 0 "$SCREEN" -nolisten tcp -noreset &
XVFB_PID=$!

for _ in $(seq 1 100); do
  if xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then break; fi
  if ! kill -0 "$XVFB_PID" 2>/dev/null; then
    log "Xvfb died during startup"
    printf 'Xvfb failed to start\n' > "$FLAG_DIR/attention" || true
    exit 1
  fi
  sleep 0.1
done

if ! xdpyinfo -display "$DISPLAY_NUM" >/dev/null 2>&1; then
  log "Xvfb never became ready"
  printf 'Xvfb never became ready\n' > "$FLAG_DIR/attention" || true
  exit 1
fi

# A window manager is required: Chrome opens at 0x0 without one and the agent
# cannot reason about a 1-pixel window.
xfce4-session &
XFCE_PID=$!
for _ in $(seq 1 100); do
  if xprop -root _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1; then break; fi
  sleep 0.1
done

# The shell is the desktop's face: a top bar and a dock, in place of xfce4-panel
# (which this image does not install). If it fails, the session still works - the
# windows are what matter - so a missing GDK does not take the desktop with it.
if [ -x /usr/local/bin/amaara-shell ]; then
  amaara-shell &
  SHELL_PID=$!
  log "amaara-shell started (pid $SHELL_PID)"
fi

CHROME_BIN="${OPENPC_CHROME:-chromium}"
CHROME_ARGS=(
  --no-first-run
  --no-default-browser-check
  --disable-dev-shm-usage
  --disable-background-networking
  --disable-features=Translate,MediaRouter
  --password-store=basic
  # The agent drives the page through CDP; cua-driver uses X input.
  --remote-debugging-port=9222
  --remote-debugging-address=127.0.0.1
  --user-data-dir="$CHROME_USER_DIR"
  --window-size=1920,1080
  --start-maximized
)

# Setup owns the screen until the customer has entered a license and chosen what
# to install. Two conditions, both cheap, before the kiosk is used: the setup
# service answers, and the state says it is not finished. A missing service must
# not leave a blank screen where a working desktop should be.
SETUP_URL="${AMAARA_SETUP_URL:-http://127.0.0.1:8099}"
SETUP_STATE="${AMAARA_SETUP_STATE:-/var/lib/amaara/setup/state.json}"
setup_phase() {
  sed -n 's/.*"phase": *"\([a-z]*\)".*/\1/p' "$SETUP_STATE" 2>/dev/null | head -n 1
}
if command -v curl >/dev/null 2>&1    && curl -fsS --max-time 15 "$SETUP_URL/healthz" >/dev/null 2>&1    && [ "$(setup_phase)" != "complete" ]; then
  log "setup is not complete; showing the setup screen at $SETUP_URL"
  CHROME_ARGS+=( --kiosk "$SETUP_URL/" )
  # The kiosk cannot watch itself. When setup finishes, killing the browser makes
  # this script exit non-zero, systemd restarts the unit, and the second start
  # sees phase=complete and opens the agent's desktop. That keeps the whole
  # handover inside this unit, with no systemctl call from a sandboxed service.
  (
    while kill -0 "$CHROME_PID" 2>/dev/null; do
      if [ "$(setup_phase)" = "complete" ]; then
        log "setup complete; handing the screen to the desktop"
        kill "$CHROME_PID" 2>/dev/null || true
        exit 0
      fi
      sleep 5
    done
  ) &
fi

log "starting $CHROME_BIN"
"$CHROME_BIN" "${CHROME_ARGS[@]}" &
CHROME_PID=$!

# If Chrome exits, the desktop is useless: fail the unit so systemd restarts it
# and the LED stops claiming everything is fine.
wait "$CHROME_PID"
log "browser exited; tearing down session"
exit 1
